{
  "name": "@tokamak-zk-evm/cli",
  "version": "3.0.1",
  "description": "Tokamak zk-EVM CLI for installing the local prover runtime and running synthesize, preprocess, prove, verify, and proof export commands.",
  "keywords": [
    "cli",
    "ethereum",
    "ethereum-cli",
    "proof-generation",
    "prover",
    "rollup",
    "state-channel",
    "tokamak",
    "tokamak-cli",
    "tokamak-network",
    "JehyukJang",
    "tokamak-zk-evm",
    "zk-proof",
    "zk-EVM",
    "zk-SNARK",
    "zero-knowledge"
  ],
  "homepage": "https://github.com/JehyukJang/Tokamak-zk-EVM/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/JehyukJang/Tokamak-zk-EVM/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JehyukJang/Tokamak-zk-EVM.git",
    "directory": "packages/cli"
  },
  "license": "MIT OR Apache-2.0",
  "author": "Tokamak Network",
  "contributors": [
    "JehyukJang <https://github.com/JehyukJang>"
  ],
  "type": "commonjs",
  "tokamakZkEvm": {
    "compatibleBackendVersion": "3.0"
  },
  "bin": {
    "tokamak-cli": "dist/cli.js"
  },
  "files": [
    ".dockerignore",
    "docker",
    "dist",
    "manifests",
    "vendor",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prepare:package": "npm run contracts:prepare && node scripts/prepare-package.mjs",
    "contracts:prepare": "node ../backend/common/scripts/prepare-contract-consumers.mjs",
    "contracts:check": "npm run contracts:prepare && node ../backend/common/scripts/check-contract-closure.mjs && node ../backend/common/scripts/prepare-contract-consumers.mjs --check",
    "build": "npm run prepare:package && npm run clean && tsc -p tsconfig.json --pretty false",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "release:package:check": "npm run build && node scripts/check-packaged-runtime.cjs --static-only",
    "release:runtime:check": "npm run build && node scripts/check-packaged-runtime.cjs",
    "test": "npm run contracts:check && npm run build && node --test tests/*.test.cjs",
    "typecheck": "npm run contracts:check && tsc -p tsconfig.json --pretty false --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tokamak-zk-evm/subcircuit-library": "3.0.1",
    "@tokamak-zk-evm/synthesizer-node": "3.0.1",
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.15.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
