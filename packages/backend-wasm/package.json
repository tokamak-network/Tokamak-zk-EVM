{
  "name": "@tokamak-zk-evm/backend-wasm",
  "version": "2.1.1",
  "description": "Web-compatible Tokamak zk-EVM prover and verifier package scaffold.",
  "license": "GPL-3.0-or-later",
  "author": "Tokamak Network",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/artifacts",
    "dist/core",
    "dist/prover",
    "dist/tooling",
    "dist/utils",
    "dist/verifier",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run subcircuit-library:generate && npm run verifier-crs:generate && tsc -p tsconfig.json --pretty false",
    "prepack": "npm run clean && npm run build",
    "typecheck": "npm run subcircuit-library:check && npm run verifier-crs:check && tsc -p tsconfig.json --pretty false --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.dev.json --pretty false",
    "binary:check": "tsx test/checks/artifacts/check-binary-artifacts.ts",
    "bench:binding-scalar-conversion": "tsx test/benchmarks/msm/bench-binding-scalar-conversion.ts",
    "bench:commitment-density": "tsx test/benchmarks/msm/bench-commitment-density.ts",
    "bench:coefficient-rescale": "tsx test/benchmarks/prover-operations/bench-coefficient-rescale.ts",
    "bench:opening-commitments": "tsx test/benchmarks/prover-operations/bench-opening-commitments.ts",
    "bench:copy-linear-fusion": "tsx test/benchmarks/prover-operations/bench-copy-linear-fusion.ts",
    "bench:crs-representation": "node --expose-gc --import tsx test/benchmarks/prover-operations/bench-crs-representation.ts",
    "bench:msm": "tsx test/benchmarks/msm/bench-msm.ts",
    "bench:msm:primitive": "tsx test/benchmarks/msm/bench-primitive-msm.ts",
    "bench:generic-mul-buffers": "tsx test/benchmarks/prover-operations/bench-generic-multiplication-buffers.ts",
    "bench:k0-mul": "tsx test/benchmarks/prover-operations/bench-k0-multiplication.ts",
    "bench:kl-mul": "tsx test/benchmarks/prover-operations/bench-lagrange-kl-multiplication.ts",
    "bench:linear-wasm": "tsx test/benchmarks/prover-operations/bench-linear-wasm-batches.ts",
    "bench:opening-pc-fusion": "tsx test/benchmarks/prover-operations/bench-opening-pc-fusion.ts",
    "bench:shifted-rou-products": "tsx test/benchmarks/prover-operations/bench-shifted-rou-products.ts",
    "bench:special-form-mul": "tsx test/benchmarks/prover-operations/bench-special-form-multiplication.ts",
    "bench:ruffini": "tsx test/benchmarks/prover-operations/bench-ruffini-division.ts",
    "bench:evaluation": "tsx test/benchmarks/prover-operations/bench-polynomial-evaluation.ts",
    "bench:vanishing": "tsx test/benchmarks/prover-operations/bench-vanishing-division.ts",
    "bench:recursion-recurrence": "tsx test/benchmarks/prover-operations/bench-recursion-recurrence.ts",
    "bench:2d-ntt": "tsx test/benchmarks/prover-operations/bench-2d-ntt-segment-scheduler.ts",
    "bench:prover-init": "tsx test/benchmarks/prover-init/bench-prover-init.ts",
    "bench:prover-init:sparse": "tsx test/benchmarks/prover-init/bench-sparse-witness-accumulation.ts",
    "bench:prover-msm-layout": "tsx test/benchmarks/msm/bench-prover-msm-layout.ts",
    "fixtures:copy": "tsx scripts/fixtures/copy-fixtures.ts fixtures/small/copy-manifest.json",
    "fixtures:prepare": "tsx scripts/fixtures/prepare-runtime-fixtures.ts fixtures/small/copy-manifest.json",
    "fixtures:check:native-verifier": "tsx test/checks/fixtures/check-native-verifier-fixture.ts fixtures/small/copy-manifest.json",
    "fixtures:diagnose:verifier": "tsx test/diagnostics/diagnose-verifier-fixture.ts fixtures/small/copy-manifest.json",
    "diagnose:prover:recursion-evaluation": "tsx test/diagnostics/prover/diagnose-recursion-evaluation.ts",
    "polynomial:buffer:check": "tsx test/checks/polynomial/check-polynomial-buffer.ts",
    "prover:ops:check": "npm run prover:ops:field && npm run polynomial:buffer:check && npm run prover:ops:polynomial && npm run prover:ops:commitment",
    "prover:ops:commitment": "tsx test/checks/prover/check-prover-commitment-ops.ts",
    "prover:ops:field": "tsx test/checks/prover/check-field-buffer-ops.ts",
    "prover:ops:polynomial": "tsx test/checks/prover/check-prover-polynomial-ops.ts",
    "prover:check": "tsx test/checks/prover/check-prover-fixture.ts",
    "prover:browser:check": "tsx test/checks/browser/check-prover-browser.ts",
    "prover:testing-mode:check": "tsx test/checks/prover/check-prover-testing-mode.ts",
    "prover:witness:check": "tsx test/checks/prover/check-prover-witness.ts",
    "rkyv-decoder:build": "npm --prefix tools/rkyv-decoder-wasm run build",
    "rkyv-decoder:check-tools": "npm --prefix tools/rkyv-decoder-wasm run check:build-tools",
    "rkyv:payload:check": "tsx test/checks/artifacts/check-rkyv-decoder-payload.ts",
    "specs:check": "tsx scripts/generate/generate-format-specs.ts --check",
    "specs:generate": "tsx scripts/generate/generate-format-specs.ts",
    "subcircuit-library:check": "tsx scripts/generate/generate-subcircuit-library.ts --check",
    "subcircuit-library:generate": "tsx scripts/generate/generate-subcircuit-library.ts",
    "verifier-crs:check": "tsx scripts/generate/generate-verifier-crs.ts --input ../backend/setup/output/sigma_verify.json --check",
    "verifier-crs:generate": "tsx scripts/generate/generate-verifier-crs.ts --input ../backend/setup/output/sigma_verify.json",
    "verifier:browser:check": "tsx test/checks/browser/check-verifier-browser.ts",
    "verifier:check": "tsx test/checks/verifier/check-verifier-fixture.ts",
    "clean": "rm -rf dist",
    "prover:stage-timing:check": "tsx test/checks/prover/check-prover-stage-timing.ts",
    "bench:packed-r1cs": "tsx test/benchmarks/prover-init/bench-packed-r1cs.ts",
    "bench:binding-zero-compaction": "tsx test/benchmarks/msm/bench-binding-zero-compaction.ts",
    "bench:flat-witness": "node --expose-gc --import tsx test/benchmarks/prover-init/bench-flat-witness.ts",
    "bench:recursion-clone-removal": "node --expose-gc --import tsx test/benchmarks/prover-operations/bench-recursion-clone-removal.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tokamak-zk-evm/subcircuit-library": "2.1.1",
    "ffjavascript": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.14",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
