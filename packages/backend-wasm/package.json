{
  "name": "@tokamak-zk-evm/snark-browser-compat",
  "version": "2.1.3",
  "description": "@tokamak-zk-evm/snark-browser-compat provides browser-compatible Tokamak zk-EVM preprocessing, proof generation, verification, and artifact conversion.",
  "license": "MIT OR Apache-2.0",
  "author": "Tokamak Network",
  "keywords": [
    "tokamak-zk-evm",
    "zero-knowledge-proofs",
    "browser-prover",
    "proof-verification",
    "webassembly",
    "wasm",
    "bls12-381"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokamak-network/Tokamak-zk-EVM.git",
    "directory": "packages/backend-wasm"
  },
  "homepage": "https://github.com/tokamak-network/Tokamak-zk-EVM/tree/main/packages/backend-wasm#readme",
  "bugs": {
    "url": "https://github.com/tokamak-network/Tokamak-zk-EVM/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./prover": {
      "types": "./dist/prover/index.d.ts",
      "import": "./dist/prover/index.js"
    },
    "./preprocess": {
      "types": "./dist/preprocess/index.d.ts",
      "import": "./dist/preprocess/index.js"
    },
    "./verifier": {
      "types": "./dist/verifier/index.d.ts",
      "import": "./dist/verifier/index.js"
    },
    "./converter": {
      "types": "./dist/converter/index.d.ts",
      "import": "./dist/converter/index.js"
    }
  },
  "files": [
    "dist/backend-wasm-error.js",
    "dist/backend-wasm-error.d.ts",
    "dist/version.js",
    "dist/version.d.ts",
    "dist/artifacts",
    "dist/runtime",
    "dist/prover",
    "dist/preprocess",
    "dist/converter",
    "dist/verifier",
    "README.md",
    "CONTRIBUTING.md",
    "examples/browser",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "build": "npm run subcircuit-library:generate && npm run verifier-crs:generate && npm run rkyv-decoder:build && tsc -p tsconfig.json --pretty false && npm run converter-worker:build",
    "prepack": "npm run clean && npm run build",
    "typecheck": "npm run subcircuit-library:check && npm run verifier-crs:check && tsc -p tsconfig.json --pretty false --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.dev.json --pretty false",
    "binary:check": "tsx test/checks/binary/check-binary-artifacts.ts && tsx test/checks/binary/check-instance-conversion.ts && tsx test/checks/binary/check-crs-conversion.ts",
    "fixtures:copy": "tsx scripts/fixtures/copy-fixtures.ts fixtures/small/copy-manifest.json",
    "fixtures:prepare": "tsx scripts/fixtures/prepare-runtime-fixtures.ts fixtures/small/copy-manifest.json",
    "fixtures:check:native-verifier": "tsx test/checks/fixtures/check-native-verifier-fixture.ts fixtures/small/copy-manifest.json",
    "polynomial:buffer:check": "tsx test/checks/polynomial/check-polynomial-buffer.ts",
    "preprocess:check": "tsx test/checks/preprocess/check-preprocess-fixture.ts",
    "preprocess:public-api:check": "tsx test/checks/preprocess/check-preprocess-public-api.ts",
    "preprocess:verify:check": "tsx test/checks/preprocess/check-preprocess-native-proof.ts",
    "preprocess:baseline": "tsx test/benchmarks/preprocess/baseline.ts",
    "preprocess:browser:check": "tsx test/checks/browser/check-preprocess-browser.ts",
    "preprocess:bench:pipeline:browser": "tsx test/checks/browser/check-preprocess-browser.ts",
    "preprocess:bench:permutation-grid": "tsx test/benchmarks/preprocess/permutation-grid.ts",
    "preprocess:bench:inverse-ntt": "tsx test/benchmarks/preprocess/inverse-ntt.ts",
    "preprocess:bench:sigma1-encoding": "tsx test/benchmarks/preprocess/sigma1-encoding.ts",
    "preprocess:bench:msm-scheduling": "tsx test/benchmarks/preprocess/msm-scheduling.ts",
    "preprocess:bench:chunk-size": "tsx test/benchmarks/preprocess/chunk-size.ts",
    "preprocess:bench:chunk-size:final": "tsx test/benchmarks/preprocess/chunk-size-suite.ts",
    "preprocess:bench:o-pub-fix": "tsx test/benchmarks/preprocess/o-pub-fix.ts",
    "preprocess:bench:pipeline": "tsx test/benchmarks/preprocess/pipeline.ts",
    "prover:ops:check": "npm run prover:ops:field && npm run polynomial:buffer:check && npm run prover:ops:polynomial && npm run prover:ops:commitment",
    "prover:ops:commitment": "tsx test/checks/prover/check-prover-commitment-ops.ts",
    "prover:ops:field": "tsx test/checks/prover/check-field-buffer-ops.ts",
    "prover:ops:polynomial": "tsx test/checks/prover/check-prover-polynomial-ops.ts",
    "prover:check": "tsx test/checks/prover/check-prover-fixture.ts",
    "prover:browser:check": "tsx test/checks/browser/check-prover-browser.ts",
    "prover:staged:browser:check": "BACKEND_WASM_BROWSER_PROVER_MODE=staged tsx test/checks/browser/check-prover-browser.ts",
    "prover:testing-mode:check": "tsx test/checks/prover/check-prover-testing-mode.ts",
    "prover:witness:check": "tsx test/checks/prover/check-prover-witness.ts",
    "rkyv-decoder:build": "npm --prefix tools/rkyv-decoder-wasm run build",
    "rkyv-decoder:check-tools": "npm --prefix tools/rkyv-decoder-wasm run check:build-tools",
    "converter-worker:build": "node scripts/package/build-converter-worker.mjs",
    "converter:browser:check": "npm run build && tsx test/checks/browser/check-crs-converter-browser.ts",
    "docs:examples:check": "npm run build && tsx test/checks/docs/check-browser-example.ts",
    "docs:publication:check": "npm run docs:examples:check && tsx test/checks/docs/check-publication-docs.ts",
    "rkyv:payload:check": "tsx test/checks/binary/check-rkyv-decoder-payload.ts",
    "specs:check": "tsx scripts/generate/generate-format-specs.ts --check",
    "specs:generate": "tsx scripts/generate/generate-format-specs.ts",
    "subcircuit-library:check": "tsx scripts/generate/generate-subcircuit-library.ts --check",
    "subcircuit-library:generate": "tsx scripts/generate/generate-subcircuit-library.ts",
    "verifier-crs:check": "tsx scripts/generate/generate-verifier-crs.ts --input ../backend/setup/output/sigma_verify.json --check",
    "verifier-crs:generate": "tsx scripts/generate/generate-verifier-crs.ts --input ../backend/setup/output/sigma_verify.json",
    "verifier:browser:check": "tsx test/checks/browser/check-verifier-browser.ts",
    "verifier:check": "tsx test/checks/verifier/check-verifier-fixture.ts",
    "clean": "rm -rf dist",
    "clean:temp": "node scripts/package/clean-temporary.mjs",
    "prover:stage-timing:check": "tsx test/checks/prover/check-prover-stage-timing.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@tokamak-zk-evm/subcircuit-library": "2.1.3",
    "ffjavascript": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.14",
    "esbuild": "^0.28.1",
    "marked": "^18.0.7",
    "playwright": "^1.61.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
