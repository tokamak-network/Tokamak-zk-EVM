+#[derive(Default)]
+pub struct CpuMsmCache<'a> {
+    ranges: Vec<(&'a [UnivariateG1Rkyv], usize, Vec<ark_bls12_381::G1Affine>)>,
+}
+
+fn decode_cpu(bases: &[UnivariateG1Rkyv]) -> Vec<ark_bls12_381::G1Affine> {
+    use ark_bls12_381::{Fq, G1Affine};
+    use ark_ff::PrimeField;
+    use rayon::prelude::*;
+    bases
+        .par_iter()
+        .map(|p| {
+            if p.x == [0; 48] && p.y == [0; 48] {
+                G1Affine::identity()
+            } else {
+                G1Affine::new_unchecked(
+                    Fq::from_le_bytes_mod_order(&p.x),
+                    Fq::from_le_bytes_mod_order(&p.y),
+                )
+            }
+        })
+        .collect()
+}
+
+fn cpu_msm_bytes(points: &[ark_bls12_381::G1Affine], scalars: &[ark_bls12_381::Fr]) -> [u8; 96] {
+    use ark_ec::AffineRepr;
+    use ark_ff::{BigInteger, PrimeField};
+    let p = super::msm_kernel::msm(points, scalars);
+    let mut bytes = [0; 96];
+    if !p.is_zero() {
+        bytes[..48].copy_from_slice(&p.x.into_bigint().to_bytes_le());
+        bytes[48..].copy_from_slice(&p.y.into_bigint().to_bytes_le());
+    }
+    bytes
+}
