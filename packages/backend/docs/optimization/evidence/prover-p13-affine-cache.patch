diff --git a/packages/backend/rust/prove/src/univariate/optimization_tests.rs b/packages/backend/rust/prove/src/univariate/optimization_tests.rs
index 346eb7072..ee6f8f299 100644
--- a/packages/backend/rust/prove/src/univariate/optimization_tests.rs
+++ b/packages/backend/rust/prove/src/univariate/optimization_tests.rs
@@ -168,0 +169,42 @@ fn zero_filter_preserves_msm_and_rejects_length_mismatch() {
+#[test]
+fn cached_commitment_ranges_match_uncached_commitments() {
+    use ark_bls12_381::{Fr, G1Affine};
+    use ark_ec::{AffineRepr, CurveGroup};
+    use ark_ff::{BigInteger, PrimeField};
+    let records: Vec<_> = (0..64)
+        .map(|i| {
+            let p = G1Affine::generator()
+                .mul_bigint(Fr::from_usize(i + 1).into_bigint())
+                .into_affine();
+            UnivariateG1Rkyv {
+                x: p.x.into_bigint().to_bytes_le().try_into().unwrap(),
+                y: p.y.into_bigint().to_bytes_le().try_into().unwrap(),
+            }
+        })
+        .collect();
+    let other: Vec<_> = records.iter().rev().copied().collect();
+    let mut cache = engine::CpuMsmCache::default();
+    for (start, end) in [(0, 32), (0, 31), (16, 48), (32, 64), (1, 8), (0, 0)] {
+        for sparse in [false, true] {
+            let values: Vec<_> = (start..end)
+                .map(|i| {
+                    if sparse && i % 2 == 0 {
+                        Fr::zero()
+                    } else {
+                        Fr::from_usize(i + 9)
+                    }
+                })
+                .collect();
+            for source in [&records, &other] {
+                let terms = [(source.as_slice(), values.as_slice(), start)];
+                assert_eq!(
+                    Cpu::commit(&mut cache, "test", &terms).unwrap(),
+                    commit_uncached::<Cpu>("test", &terms).unwrap()
+                );
+            }
+        }
+    }
+    assert!(Cpu::commit(&mut cache, "test", &[(&records, &[Fr::one(); 2], 63)]).is_err());
+    assert!(Cpu::commit(&mut cache, "test", &[(&records, &[Fr::one()], usize::MAX)]).is_err());
+}
